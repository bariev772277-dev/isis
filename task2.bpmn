<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Registration" targetNamespace="https://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:collaboration id="Collaboration_Registration">
    <bpmn:participant id="Participant_Registration" name="Регистрация на сайте" processRef="Process_Registration" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Registration" isExecutable="false">
    <bpmn:laneSet id="Lanes_Registration">
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Errors</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Начало регистрации">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Input" name="Ввести имя, email и пароль">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Проверить данные">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Данные корректны?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Send" name="Отправить письмо для подтверждения">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Confirm" name="Перейти по ссылке из письма">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activate" name="Активировать аккаунт">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Регистрация успешна">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Errors" name="Показать ошибки ввода">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Input" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Errors" targetRef="Input" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Input" targetRef="Check" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Check" targetRef="Valid" />
    <bpmn:sequenceFlow id="Flow_4" name="Да" sourceRef="Valid" targetRef="Send" />
    <bpmn:sequenceFlow id="Flow_5" name="Нет" sourceRef="Valid" targetRef="Errors" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Send" targetRef="Confirm" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Confirm" targetRef="Activate" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activate" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Registration">
    <bpmndi:BPMNPlane id="Plane_Registration" bpmnElement="Collaboration_Registration">
      <bpmndi:BPMNShape id="Participant_Registration_di" bpmnElement="Participant_Registration" isHorizontal="true">
        <dc:Bounds x="155" y="67" width="1180" height="385" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="185" y="212" width="1150" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
        <dc:Bounds x="185" y="67" width="1150" height="145" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="230" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="206" y="163" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Input_di" bpmnElement="Input">
        <dc:Bounds x="305" y="100" width="144" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_di" bpmnElement="Check">
        <dc:Bounds x="478" y="241" width="125" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Valid_di" bpmnElement="Valid" isMarkerVisible="true">
        <dc:Bounds x="640" y="256" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="616" y="220" width="98" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Send_di" bpmnElement="Send">
        <dc:Bounds x="734" y="241" width="145" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Confirm_di" bpmnElement="Confirm">
        <dc:Bounds x="902" y="100" width="143" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activate_di" bpmnElement="Activate">
        <dc:Bounds x="1085" y="241" width="131" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="1262" y="263" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1234" y="307" width="92" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Errors_di" bpmnElement="Errors">
        <dc:Bounds x="595" y="353" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="266" y="140" />
        <di:waypoint x="305" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="449" y="140" />
        <di:waypoint x="540" y="140" />
        <di:waypoint x="540" y="241" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="603" y="281" />
        <di:waypoint x="640" y="281" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="690" y="281" />
        <di:waypoint x="734" y="281" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="703" y="261" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="665" y="306" />
        <di:waypoint x="665" y="353" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="675" y="321" width="21" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="595" y="388" />
        <di:waypoint x="377" y="388" />
        <di:waypoint x="377" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="807" y="241" />
        <di:waypoint x="807" y="140" />
        <di:waypoint x="902" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1045" y="140" />
        <di:waypoint x="1150" y="140" />
        <di:waypoint x="1150" y="241" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1216" y="281" />
        <di:waypoint x="1262" y="281" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
